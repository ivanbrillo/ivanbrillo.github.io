<div class="col project-col">
  <a class="project-card" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="project-thumb">
      {% if project.img %}
        {%
          include figure.liquid
          loading="lazy"
          path=project.img
          sizes="(min-width: 992px) 320px, (min-width: 576px) 45vw, 90vw"
          alt=project.title
          class="project-img"
        %}
      {% else %}
        <div class="project-thumb-placeholder"><i class="fa-solid fa-{{ project.icon | default: 'flask' }}"></i></div>
      {% endif %}
    </div>
    <div class="project-body">
      <h3 class="project-title">{{ project.title }}</h3>
      {% if project.description %}
        <p class="project-desc">{{ project.description }}</p>
      {% endif %}
      {% if project.tags %}
        <ul class="project-tags">
          {% for tag in project.tags %}
            <li>{{ tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </a>
</div>
